#include <stdio.h>
int main() 
{
    int n, a[10], i; 
    printf("Enter the marks of the student: ");
    scanf("%d", &n);
    if (n > 90) 
    {
        printf("Grade: A\n");
    } 
    else if (n > 80) 
    {
        printf("Grade: B\n");
    } 
    else 
    {
        printf("Grade: C\n");
    }
    printf("Enter the marks of 10 subjects:\n");
    int sum = 0; 
    for (i = 0; i < 10; i++) {
        printf("Subject %d: ", i + 1);
        scanf("%d", &a[i]);
        sum = sum + a[i]; 
    }
    printf("The average marks of the student are: %f\n",(float)sum / 10);
    return 0;
}
