#include <iostream>
#include <string>
#include <algorithm> 
#include <vector>
using namespace std;
void permute(string& s, int l, int r)
{
    if (l == r) 
    {
        cout << s << " ";
    }
    else 
    {
        for (int i = l; i <= r; i++)
        {
            swap(s[l], s[i]);
            permute(s, l + 1, r);
            swap(s[l], s[i]);
        }
    }
}
int main()
{
    string input = "hgjkgjkhkjhk";
    int n = input.length();
    cout << "The permutations of " << input << " are: " << endl;
    cout<<"Length of string:"<<input.length()<<endl;
    permute(input, 0, n - 1);
    cout << endl;
    return 0;
}
