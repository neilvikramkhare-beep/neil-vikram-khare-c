#include <stdio.h>
int main() 
{
    int i, j, n, minIndex, temp;
    int a[100]; 
    printf("Enter the array size (max 100): ");
    if (scanf("%d", &n) != 1 || n <= 0 || n > 100) 
    {
        printf("Invalid array size.\n");
        return 1;
    }
    printf("Enter %d array elements:\n", n);
    for (i = 0; i < n; i++) 
    {
        if (scanf("%d", &a[i]) != 1) 
        {
            printf("Invalid input for array elements.\n");
            return 1; 
        }
    }
    for (i = 0; i < n - 1; i++) 
    {
        minIndex = i;
        for (j = i + 1; j < n; j++) 
        {
            if (a[j] < a[minIndex]) 
            {
                minIndex = j;
            }
        }
        if (minIndex != i) 
        {
            temp = a[i];
            a[i] = a[minIndex];
            a[minIndex] = temp;
        }
    }
    printf("Sorted array:\n");
    for (i = 0; i < n; i++)
    {
        printf("%d ", a[i]);
    }
    printf("\n");
    return 0;
}
