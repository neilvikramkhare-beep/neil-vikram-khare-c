#include <stdio.h>
int main()
{
    int a[10], i, n, temp = 0;
    printf("Enter the number of elements in the array:\n");
    scanf("%d", &n); 
    if (n > 10 || n < 1)
    {
        printf("Invalid number of elements. Please enter a value between 1 and 10.\n");
        return 1; 
    }
    printf("Enter the array elements:\n");
    for (i = 0; i < n; i++)
    { 
        scanf("%d", &a[i]); 
    }
    printf("\n");
    if (n > 0)
    {
        temp = a[0];
        for (i = 0; i < n - 1; i++)
        {
            a[i] = a[i + 1];
        }
        a[n - 1] = temp;
    }
    printf("Array after left shift:\n");
    for (i = 0; i < n; i++) 
    { 
        printf("%d ", a[i]); 
    }
    printf("\n");
    return 0;
}
