#include <stdio.h> 
int main()
{ 
    int n; 
    int sum = 0; 
    int i; 
    printf("Enter a number:"); 
    scanf("%d", &n); 
        for (i = 0; i < n; i++) 
        {
    if (i % 2 == 0) 
    { 
        sum = sum + i;
    }
}
    printf("The sum of  even numbers from 0 to %d is:%d\n",n, sum);
        return 0;
    }
   
