#include <stdio.h>
int main()
{
    int i, index = -1, a[10], key = 56;
    printf("Enter 10 elements:\n");
    for (i = 0; i < 10; i++)
    {
        printf("Element %d: ", i + 1);
        scanf("%d", &a[i]);
    }
    for (i = 0; i < 10; i++) 
    {
        if (key == a[i]) 
        {
            index = i; 
            break;     
        }
    }
    if (index != -1)
    {
        printf("Element %d found at index %d\n", key, index);
    }
    else
    {
        printf("Element %d not found.\n", key);
    }
    return 0;
}
