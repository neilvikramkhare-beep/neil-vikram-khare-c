#include <stdio.h>
int main() 
{
    int start = 2000;
    int end = 2025;
    printf("Leap years between %d and %d:\n", start, end);
    for (int year = start; year <= end; year++) 
    {
int isLeap = ((year % 4 == 0) && (year % 100 != 0)) || (year % 400 == 0);
        if (isLeap)
        {
            printf("%d\n", year);
        }
    }
    return 0;
}
