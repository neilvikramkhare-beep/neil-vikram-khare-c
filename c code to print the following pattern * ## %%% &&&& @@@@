#include <stdio.h>
int main() 
{
    for (int i = 1; i <= 4; i++) 
    {
        for (int j = 0; j < i; j++) 
        {
            if (i == 3) printf("%%");  
            else if (i == 1) printf("*");
            else if (i == 2) printf("#");
            else if (i == 4) printf("&");
        }
        printf("\n");
    }
    for (int i = 0; i < 5; i++) 
    {
        printf("@");
    }
    return 0;
}
