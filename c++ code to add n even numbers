#include <stdio.h>
int main()
{
    int n, i, sum = 0;
    printf("Enter a number: ");
    scanf("%d", &n);
    printf("Even numbers up to %d are: ", 2 * n);
    for (i = 1; i <= n; i++)
    {
        int even = 2 * i;
        printf("%d ", even);
        sum += even;
    }
    printf("\nSum of the first %d even numbers is: %d\n", n, sum);
    return 0;
}
